# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- Discord -----------------------------------------------------------------
DISCORD_TOKEN=
# Comma or space separated Discord user IDs. Anything not listed is refused.
ALLOWED_USER_IDS=
# Optional: sync slash commands instantly to one guild instead of globally.
GUILD_ID=
# Optional: where job results go. Empty = the channel the job was started in.
NOTIFY_CHANNEL_ID=
# Optional: the #ai channel by ID, or by name via AI_CHANNEL_NAME.
AI_CHANNEL_ID=
AI_CHANNEL_NAME=ai

# --- Repository --------------------------------------------------------------
# The branch the bot builds and diffs against. Never main/master.
AUTHORIZED_BRANCH=freebuff/ce4b8907c250c30103d8993e
# Empty = the checkout that contains mac-builder/. On the Mac that is the
# Hustler checkout, which is also where mac-builder/ lives. At startup the bot
# refuses a target without ios-app/project.yml, or without AUTHORIZED_BRANCH as
# a local branch there.
REPO_DIR=
# Optional labels used by /project and the manager.
# Empty PROJECT_NAME = the target checkout's folder name.
PROJECT_NAME=
BUILDER_NAME=Freebuff
BOT_NAME=Melisa
# Empty = mac-builder/logs
LOG_DIR=
# Empty = ~/mac-builder-worktrees (kept outside the repo)
WORKTREE_ROOT=

# --- Xcode / test scripts ----------------------------------------------------
HUSTLERCORE_DIR=ios-app/HustlerCore
XCODE_PROJECT=ios-app/Hustler.xcodeproj
XCODE_SCHEME=Hustler
# Prefer an existing iPhone simulator name; falls back to the first available.
SIMULATOR_NAME=iPhone 16
# Keep these small on an 8 GB M1.
SWIFT_JOBS=2
XCODEBUILD_JOBS=2

# --- Freebuff ----------------------------------------------------------------
# An interactive Freebuff CLI that accepts a task typed into its terminal.
FREEBUFF_BIN=freebuff
# Optional fixed arguments, split like a shell line (never from Discord).
FREEBUFF_ARGS=
FREEBUFF_READY_SECONDS=60
FREEBUFF_IDLE_SECONDS=120
FREEBUFF_POLL_SECONDS=10
FREEBUFF_TIMEOUT_SECONDS=1800
# A pane and a worktree both unchanged this long is a screen, not progress: it is
# posted once with its kind, the clocks pause, and /screen, /key and /send work.
STALL_SECONDS=90
# The live status board. Minimum seconds between edits of one board message, so
# Discord is never rate-limited; the silence that earns one "has not moved" ping;
# and whether those pings are sent at all.
STATUS_EDIT_MIN_SECONDS=15
STATUS_STALL_PING_SECONDS=600
STATUS_PINGS=1
# While Freebuff sits on a question box the job waits for /answer: the idle timer
# is paused and the hard timeout is pushed out. After this many seconds the box is
# dismissed with Esc and the job fails.
QUESTION_WAIT_SECONDS=1800
# Let the manager answer a question instead of you, but only when it replies with
# high confidence. Off by default: the manager endpoint is rate limited (HTTP 429).
QUESTION_AUTO_ANSWER=0
# At most this many auto-answers per job; after that every question is yours.
QUESTION_AUTO_ANSWER_MAX=3
# After a 429 or a timeout from the manager, skip manager calls for this long and
# send the questions to you instead.
QUESTION_MANAGER_COOLDOWN_SECONDS=30
# 1 = post the question immediately and add the manager's advice as a follow-up
# ("suggestion only, you decide"). It never delays the question, never blocks
# /answer and is never typed into the session. Off by default.
QUESTION_SUGGEST=0
# 1 = write the whole pane to the job log after every key sent to a question box.
# Use it once to learn the real box, then turn it off.
QUESTION_DEBUG=0

# --- AI manager (any OpenAI-compatible chat endpoint) ------------------------
# Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1,
#           http://localhost:11434/v1 (base URL only; /chat/completions is added).
MANAGER_API_BASE=
MANAGER_API_KEY=
MANAGER_MODEL=
# Reply budget. Reasoning models (Gemini flash and friends) spend tokens
# thinking before answering; a small budget looks like an empty reply.
MANAGER_MAX_TOKENS=4000
MANAGER_TIMEOUT_SECONDS=120

# --- Hard guardrails ---------------------------------------------------------
MAX_DIFF_LINES=400
MAX_REVISE_ROUNDS=2
MAX_PENDING_JOBS=10

# --- Timeouts (seconds) ------------------------------------------------------
CHECK_TIMEOUT_SECONDS=1800
TEST_TIMEOUT_SECONDS=2700
BUILD_TIMEOUT_SECONDS=1800
STATUS_TIMEOUT_SECONDS=60

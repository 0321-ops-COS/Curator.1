<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    LaunchAgent, not a LaunchDaemon: the iOS Simulator needs the logged-in
    Aqua session. Install to ~/Library/LaunchAgents/ and load with:
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hustler.macbuilder.plist

    mac-builder/ now lives in the Curator.1 checkout, not in Hustler. MB below is
    the ONLY place the path appears: it defaults to ~/Curator.1/mac-builder and
    can be overridden by setting MACBUILDER_DIR in EnvironmentVariables (or by
    editing that one line). The Label keeps its old com.hustler. name because it
    is only an identifier; renaming it means bootout + bootstrap again.

    The project she builds is a different checkout, set in .env as REPO_DIR.
    On startup the bot logs `code: <folder> [<branch>@<commit>] · env: ... · logs:
    ...` so you can see which folder and commit actually ran.
  -->
  <key>Label</key>
  <string>com.hustler.macbuilder</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>MB="${MACBUILDER_DIR:-$HOME/Curator.1/mac-builder}"; cd "$MB" || exit 1; exec "$MB/.venv/bin/python" "$MB/bot.py" &gt;&gt; "$MB/logs/launchd.log" 2&gt;&amp;1</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
</dict>
</plist>
